-- Swap viewport models in trade UI
local originalAttach = SharedAnimals.AttachOnViewportWithOptimizations
SharedAnimals.AttachOnViewportWithOptimizations = function(self, index, viewport, ...)
    local replacement = swaps[index]
    if replacement then
        return originalAttach(self, replacement, viewport, ...)
    end
    return originalAttach(self, index, viewport, ...)
end

local AnimalModels = ReplicatedStorage.Models.Animals
local Animations = ReplicatedStorage.Animations.Animals
local swapped = {}

local function hideModel(obj)
    for _, part in ipairs(obj:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = 1
            part.Size = Vector3.new(0.001, 0.001, 0.001)
        elseif part:IsA("Decal") or part:IsA("Texture") or part:IsA("SpecialMesh") then
            part.Transparency = 1
        end
    end
end

workspace.DescendantAdded:Connect(function(obj)
    if not obj:IsA("Model") then return end
    if swapped[obj] then return end

    for original, replacement in pairs(swaps) do
        if obj.Name == original then
            swapped[obj] = true

            task.wait(2)

            if not obj or not obj.Parent then return end

            local newModel = AnimalModels:FindFirstChild(replacement)
            if newModel then
                local clone = newModel:Clone()
                clone.Name = obj.Name
                clone:PivotTo(obj:GetPivot())
                clone.Parent = obj.Parent

                local mutation = obj:GetAttribute("Mutation")
                local traits = obj:GetAttribute("Traits")

                if mutation then
                    clone:SetAttribute("Mutation", mutation)
                    pcall(function()
                        SharedAnimals:ApplyMutation(clone, replacement, mutation)
                    end)
                end

                if traits then
                    clone:SetAttribute("Traits", traits)
                    pcall(function()
                        local HttpService = game:GetService("HttpService")
                        local decoded = HttpService:JSONDecode(traits)
                        if decoded then
                            SharedAnimals:ApplyTraits(clone, replacement, decoded)
                        end
                    end)
                end

                hideModel(obj)

                -- Set exact overhead height per OG brainrot
                local attachment = obj:FindFirstChild("OVERHEAD_ATTACHMENT", true)
                if attachment then
                    local height = overheadHeights[replacement] or 8
                    attachment.CFrame = CFrame.new(0, height, 0)
                end

                local clonePP = clone.PrimaryPart
                local objPP = obj.PrimaryPart
                if clonePP and objPP then
                    clonePP.Anchored = false
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = clonePP
                    weld.Part1 = objPP
                    weld.Parent = clonePP
                end

                local animFolder = Animations:FindFirstChild(replacement)
                if animFolder then
                    local controller = clone:FindFirstChildOfClass("AnimationController")
                        or Instance.new("AnimationController", clone)
                    local animator = controller:FindFirstChildOfClass("Animator")
                        or Instance.new("Animator", controller)
                    local idle = animFolder:FindFirstChild("Idle")
                    if idle then
                        local track = animator:LoadAnimation(idle)
                        track.Looped = true
                        track:Play()
                        track:AdjustSpeed(idle:GetAttribute("Speed") or 1)
                        local removeSync = AnimationSyncController:Add(track)
                        obj.Destroying:Connect(function()
                            removeSync()
                            track:Stop(0)
                            track:Destroy()
                        end)
                    end
                end

                obj.Destroying:Connect(function()
                    swapped[obj] = nil
                    clone:Destroy()
                end)
            end
            break
        end
    end
end)

